// Mob Battle VS screen (VsScreen.java; vsScreen in the countdown, /mobbattle test vs). GENERATED by
// scripts/gen-vs-ui.py: edit that and run it again. Look of the VS card made for the clip
// (art-source/Renders/VS/vs_card.py, user 2026-10-16): two halves split on a slant, each in its team color with light
// streaks and floating particles, a dark name bar on top, the fighters big and overlapping, a big VS.
// Layers on top of each other (no LayoutMode = overlay): each layer splits the width by FlexWeight between its half
// (0 -> 580 thousandths while sliding in, so the halves overlap where the slant is) and a transparent rest. Fighters
// and labels hang on each half's inner edge, so they slide in with it. Pictures, colors, texts and which size of
// each slot shows are set by the code.
Group #Vs {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);

  // the screen's pictures, 1 px each, behind everything (VsScreen sets them): the client loads a picture the first
  // time it draws it, and a royale's ~48 at once froze it 0.8 s right as the halves started to slide, so the crowds
  // popped in instead of sliding (recording 2026-10-17). Drawn here from the start, they load while the screen waits.
  // At their real size, under a fully transparent mask (Masks/Hidden.png): 1 px copies were not enough, the first
  // real-size draw still froze the client 0.7 s at the slide with 24 mobs (recording 2026-10-17).
  Group #Preload {
    Anchor: (Left: 0, Top: 0, Width: 384, Height: 384);
    MaskTexturePath: "Masks/Hidden.png";
    AssetImage #Pre0 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre1 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre2 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre3 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre4 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre5 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre6 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre7 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre8 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre9 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre10 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre11 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre12 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre13 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre14 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre15 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre16 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre17 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre18 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre19 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre20 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre21 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre22 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre23 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre24 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre25 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre26 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre27 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre28 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre29 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre30 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre31 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre32 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre33 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre34 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre35 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre36 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre37 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre38 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre39 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre40 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre41 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre42 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre43 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre44 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre45 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre46 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre47 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre48 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre49 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre50 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre51 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre52 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre53 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre54 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre55 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre56 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre57 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre58 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre59 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre60 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre61 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre62 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
    AssetImage #Pre63 { Anchor: (Left: 0, Top: 0, Width: 384, Height: 384); Visible: false; }
  }

  // "Preparing the battle..." while the client loads the screen (2026-10-18, user: during the wait the player could
  // think nothing happened); VsScreen hides it when the screen comes in
  Group #Loading {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Bottom;
    Group {
      Anchor: (Height: 56, Bottom: 170);
      LayoutMode: Center;
      Group {
        Anchor: (Width: 520, Height: 56);
        Background: #0b0f18(0.75);
        Label #LoadingText {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Text: %server.mobbattle.hud.vs.loading;
          Style: (FontSize: 26, FontName: "Secondary", TextColor: #ffd23e, RenderBold: true, RenderUppercase: true,
                  HorizontalAlignment: Center, VerticalAlignment: Center);
        }
      }
    }
  }

  // everything you see, hidden while the client loads the pictures through #Preload (2026-10-17, recording: each
  // half's mask hides its pictures until it slides, so they loaded at the first slide frame and the client froze
  // through the slide: the crowd popped in). VsScreen shows it when the slide starts; you see the world until then.
  Group #Show {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Visible: false;

  // a plain battle royale: one background for the whole screen (Bg_Royale.png, the halves' own ones hidden; user
  // 2026-10-16: no sides, so no split), the two crowds slide in over it
  AssetImage #RoyaleBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }

  Group #LeftLayer {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Left;

    Group #LHalf {
      FlexWeight: 1;
      // each half cut at the slant (user, 2026-10-17: as Smash; overlapping fighters crossed into the other
      // half): white where the half shows, stretched to the box like its background (gen-vs-assets.py --masks)
      // not cut at the slant: a plain battle royale has no seam

      // the half's background (Bg_<Color>_L.png: glow, streaks, particles, the slanted edge), stretched to the box
      AssetImage #LBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }

      // the fighters (2026-10-17, recordings: 40 slots x 4 sizes x nested groups were ~1300 elements, and every slide
      // step re-laid them all out, so the client drew no frame for the whole slide): one set of generic slots, a halo
      // and a picture each, all halos first; VsScreen places each one (Anchor: position and size from the layout in
      // vs-slots.json, made by this script) in drawing order, so slot 0 is the furthest back.
      Group #LSlots {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        AssetImage #LG0 { Visible: false; }
        AssetImage #LG1 { Visible: false; }
        AssetImage #LG2 { Visible: false; }
        AssetImage #LG3 { Visible: false; }
        AssetImage #LG4 { Visible: false; }
        AssetImage #LG5 { Visible: false; }
        AssetImage #LG6 { Visible: false; }
        AssetImage #LG7 { Visible: false; }
        AssetImage #LG8 { Visible: false; }
        AssetImage #LG9 { Visible: false; }
        AssetImage #LG10 { Visible: false; }
        AssetImage #LG11 { Visible: false; }
        AssetImage #LG12 { Visible: false; }
        AssetImage #LG13 { Visible: false; }
        AssetImage #LG14 { Visible: false; }
        AssetImage #LG15 { Visible: false; }
        AssetImage #LG16 { Visible: false; }
        AssetImage #LG17 { Visible: false; }
        AssetImage #LG18 { Visible: false; }
        AssetImage #LG19 { Visible: false; }
        AssetImage #LG20 { Visible: false; }
        AssetImage #LG21 { Visible: false; }
        AssetImage #LG22 { Visible: false; }
        AssetImage #LG23 { Visible: false; }
        AssetImage #LG24 { Visible: false; }
        AssetImage #LG25 { Visible: false; }
        AssetImage #LG26 { Visible: false; }
        AssetImage #LG27 { Visible: false; }
        AssetImage #LP0 { Visible: false; }
        AssetImage #LP1 { Visible: false; }
        AssetImage #LP2 { Visible: false; }
        AssetImage #LP3 { Visible: false; }
        AssetImage #LP4 { Visible: false; }
        AssetImage #LP5 { Visible: false; }
        AssetImage #LP6 { Visible: false; }
        AssetImage #LP7 { Visible: false; }
        AssetImage #LP8 { Visible: false; }
        AssetImage #LP9 { Visible: false; }
        AssetImage #LP10 { Visible: false; }
        AssetImage #LP11 { Visible: false; }
        AssetImage #LP12 { Visible: false; }
        AssetImage #LP13 { Visible: false; }
        AssetImage #LP14 { Visible: false; }
        AssetImage #LP15 { Visible: false; }
        AssetImage #LP16 { Visible: false; }
        AssetImage #LP17 { Visible: false; }
        AssetImage #LP18 { Visible: false; }
        AssetImage #LP19 { Visible: false; }
        AssetImage #LP20 { Visible: false; }
        AssetImage #LP21 { Visible: false; }
        AssetImage #LP22 { Visible: false; }
        AssetImage #LP23 { Visible: false; }
        AssetImage #LP24 { Visible: false; }
        AssetImage #LP25 { Visible: false; }
        AssetImage #LP26 { Visible: false; }
        AssetImage #LP27 { Visible: false; }
      }

      // name bar texts (the bar itself is baked into the background): small colored team label, the names in big white letters
      Group {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Top;
        Group #LBarFill {
          Anchor: (Height: 118);
          LayoutMode: Top;
          Padding: (Left: 40, Top: 16);
          Label #LTeam {
            Anchor: (Height: 36, Width: 740);
            Style: (FontSize: 28, FontName: "Secondary", TextColor: #ff6e6e, RenderBold: true, RenderUppercase: true,
                    HorizontalAlignment: Start, VerticalAlignment: Center);
          }
          Label #LNames {
            Anchor: (Height: 64, Width: 740);
            Style: (FontSize: 46, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                    ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14, HorizontalAlignment: Start, VerticalAlignment: Center);
          }
        }
      }

      // "+N" for the fighters not shown: a badge low by the screen edge (MoreBadge.png + the number)
      Group {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Bottom;
        Group {
          Anchor: (Height: 84, Bottom: 34);
          LayoutMode: Left;
          Group #LMoreBox {
            Anchor: (Width: 236, Height: 84, Left: 40);
            Visible: false;
            AssetImage #LMoreBadge { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
            Label #LMore {
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Style: (FontSize: 46, FontName: "Secondary", TextColor: #ffffff, RenderBold: true,
                      HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
      }
    }

    Group #LRest { FlexWeight: 1000; }
  }

  Group #RightLayer {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Left;

    Group #RRest { FlexWeight: 1000; }

    Group #RHalf {
      FlexWeight: 1;
      // each half cut at the slant (user, 2026-10-17: as Smash; overlapping fighters crossed into the other
      // half): white where the half shows, stretched to the box like its background (gen-vs-assets.py --masks)
      // not cut at the slant: a plain battle royale has no seam

      // the half's background (Bg_<Color>_R.png: glow, streaks, particles, the slanted edge), stretched to the box
      AssetImage #RBg { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }

      // the fighters (2026-10-17, recordings: 40 slots x 4 sizes x nested groups were ~1300 elements, and every slide
      // step re-laid them all out, so the client drew no frame for the whole slide): one set of generic slots, a halo
      // and a picture each, all halos first; VsScreen places each one (Anchor: position and size from the layout in
      // vs-slots.json, made by this script) in drawing order, so slot 0 is the furthest back.
      Group #RSlots {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        AssetImage #RG0 { Visible: false; }
        AssetImage #RG1 { Visible: false; }
        AssetImage #RG2 { Visible: false; }
        AssetImage #RG3 { Visible: false; }
        AssetImage #RG4 { Visible: false; }
        AssetImage #RG5 { Visible: false; }
        AssetImage #RG6 { Visible: false; }
        AssetImage #RG7 { Visible: false; }
        AssetImage #RG8 { Visible: false; }
        AssetImage #RG9 { Visible: false; }
        AssetImage #RG10 { Visible: false; }
        AssetImage #RG11 { Visible: false; }
        AssetImage #RG12 { Visible: false; }
        AssetImage #RG13 { Visible: false; }
        AssetImage #RG14 { Visible: false; }
        AssetImage #RG15 { Visible: false; }
        AssetImage #RG16 { Visible: false; }
        AssetImage #RG17 { Visible: false; }
        AssetImage #RG18 { Visible: false; }
        AssetImage #RG19 { Visible: false; }
        AssetImage #RG20 { Visible: false; }
        AssetImage #RG21 { Visible: false; }
        AssetImage #RG22 { Visible: false; }
        AssetImage #RG23 { Visible: false; }
        AssetImage #RG24 { Visible: false; }
        AssetImage #RG25 { Visible: false; }
        AssetImage #RG26 { Visible: false; }
        AssetImage #RG27 { Visible: false; }
        AssetImage #RP0 { Visible: false; }
        AssetImage #RP1 { Visible: false; }
        AssetImage #RP2 { Visible: false; }
        AssetImage #RP3 { Visible: false; }
        AssetImage #RP4 { Visible: false; }
        AssetImage #RP5 { Visible: false; }
        AssetImage #RP6 { Visible: false; }
        AssetImage #RP7 { Visible: false; }
        AssetImage #RP8 { Visible: false; }
        AssetImage #RP9 { Visible: false; }
        AssetImage #RP10 { Visible: false; }
        AssetImage #RP11 { Visible: false; }
        AssetImage #RP12 { Visible: false; }
        AssetImage #RP13 { Visible: false; }
        AssetImage #RP14 { Visible: false; }
        AssetImage #RP15 { Visible: false; }
        AssetImage #RP16 { Visible: false; }
        AssetImage #RP17 { Visible: false; }
        AssetImage #RP18 { Visible: false; }
        AssetImage #RP19 { Visible: false; }
        AssetImage #RP20 { Visible: false; }
        AssetImage #RP21 { Visible: false; }
        AssetImage #RP22 { Visible: false; }
        AssetImage #RP23 { Visible: false; }
        AssetImage #RP24 { Visible: false; }
        AssetImage #RP25 { Visible: false; }
        AssetImage #RP26 { Visible: false; }
        AssetImage #RP27 { Visible: false; }
      }

      Group {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Top;
        Group #RBarFill {
          Anchor: (Height: 118);
          LayoutMode: Top;
          Padding: (Right: 40, Top: 16);
          Group {
            Anchor: (Height: 36);
            LayoutMode: Right;
            Label #RTeam {
              Anchor: (Width: 960);
              Style: (FontSize: 28, FontName: "Secondary", TextColor: #82beff, RenderBold: true, RenderUppercase: true,
                      HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
          Group {
            Anchor: (Height: 64);
            LayoutMode: Right;
            Label #RNames {
              Anchor: (Width: 960);
              Style: (FontSize: 46, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                      ShrinkTextToFit: true, MinShrinkTextToFitFontSize: 14, HorizontalAlignment: End, VerticalAlignment: Center);
            }
          }
        }
      }

      // "+N" for the fighters not shown: a badge low by the screen edge (MoreBadge.png + the number)
      Group {
        Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
        LayoutMode: Bottom;
        Group {
          Anchor: (Height: 84, Bottom: 34);
          LayoutMode: Right;
          Group #RMoreBox {
            Anchor: (Width: 236, Height: 84, Right: 40);
            Visible: false;
            AssetImage #RMoreBadge { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
            Label #RMore {
              Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
              Style: (FontSize: 46, FontName: "Secondary", TextColor: #ffffff, RenderBold: true,
                      HorizontalAlignment: Center, VerticalAlignment: Center);
            }
          }
        }
      }
    }
  }

  // a plain battle royale: one centered title in the top bar instead of each half's names (user, 2026-10-17: the
  // two names read like two teams); shown with the clash, as the names
  Group #RoyaleHead {
    Anchor: (Left: 0, Right: 0, Top: 0, Height: 118);
    LayoutMode: Center;
    Visible: false;
    Label #RoyaleHeadText {
      Anchor: (Width: 1600, Height: 118);
      Style: (FontSize: 56, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
              HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }

  Group #Flash {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Background: #ffffff(0.7);
    Visible: false;
  }

  // the battle kind in the VS's own style, right under it (Kind_<kind>_<lang>.png, set by the code; user 2026-10-16)
  Group #Title {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Top;
    Visible: false;
    Group {
      Anchor: (Height: 96, Top: 706);
      LayoutMode: Center;
      AssetImage #KindTitle { Anchor: (Width: 760, Height: 96); }
    }
  }

  Group #Center {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: CenterMiddle;
    Visible: false;

    AssetImage #VsLogo { Anchor: (Width: 600, Height: 500, Top: 40); }
  }
  }
}
