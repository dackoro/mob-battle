// Mob Battle /mobbattle watch card (BattleWatch.java): the watched fighter and its stats, on the left edge (below
// the game's "Spectating" label). Paths are relative to this file. A malformed property makes the client reject the
// whole HUD, so change one thing at a time.
Group {
  Anchor: (Left: 24, Top: 110, Width: 270);
  LayoutMode: Top;

  Group #Header {
    Anchor: (Height: 34);
    Background: (TexturePath: "../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
    Padding: (Top: 6);

    Label #Title {
      Text: %server.mobbattle.hud.watching;
      Style: (FontSize: 14, FontName: "Secondary", TextColor: #ffd23e, RenderBold: true, RenderUppercase: true,
              HorizontalAlignment: Center, VerticalAlignment: Center);
    }
  }

  Group #Body {
    Anchor: (Height: 190);
    LayoutMode: Top;
    Padding: (Horizontal: 16, Vertical: 8);
    Background: (TexturePath: "../Common/ContainerPatch.png", Border: 23);

    Label #Name { Anchor: (Height: 22); Text: ""; Style: (FontSize: 15, RenderBold: true, RenderUppercase: true); }
    Label #Side { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Health { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Attack { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Defense { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Size { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Kills { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
    Label #Left { Anchor: (Height: 22); Text: ""; Style: (FontSize: 12, RenderBold: true, VerticalAlignment: Center); }
  }
}
