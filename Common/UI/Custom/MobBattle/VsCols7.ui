              // to the column (overflow hidden)
              Group #C7P0Clip {
                Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                MaskTexturePath: "Masks/Clip.png";
                LayoutMode: Top;
                Group { Anchor: (Height: 80); }
                Group {
