$C = "../../Common.ui";

// Filters above a long pick list (summon mobs, Morph Wand models, Effect Wand effects): which mod, and for mobs what
// they do, and the group (Aquatic, Undead...). #Type stays hidden for models and effects.
Group {
  LayoutMode: Left;
  Anchor: (Height: 40, Left: 6, Bottom: 2);

  Label #Label {
    Anchor: (Width: 90, Right: 8);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center);
    Text: %server.mobbattle.panel.filter.show;
  }

  $C.@DropdownBox #Mod {
    Anchor: (Width: 220, Top: 4, Height: 32, Right: 12);
  }

  $C.@DropdownBox #Type {
    Anchor: (Width: 200, Top: 4, Height: 32, Right: 12);
    Visible: false;
  }

  // The group of "Group - Name" labels (Aquatic, Undead...); its choices follow the mod and type picked.
  $C.@DropdownBox #Group {
    Anchor: (Width: 200, Top: 4, Height: 32);
    ShowSearchInput: true;
  }
}
