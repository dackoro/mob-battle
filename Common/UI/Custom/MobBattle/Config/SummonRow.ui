$C = "../../Common.ui";

// One mob of the Summon Wand list: icon, role, count (number or random), team color, team, remove. Count and team are
// kept in the panel's draft (name in gold) until Save changes.
Group {
  LayoutMode: Left;
  Anchor: (Height: 44, Bottom: 6);

  AssetImage #Icon {
    Anchor: (Width: 40, Height: 40, Left: 6, Right: 10, Top: 2);
    FallbackTexturePath: "UI/Custom/Pages/Memories/MissingIcon.png";
  }

  Label #Role {
    Anchor: (Right: 12, Width: 170);
    Style: (...$C.@DefaultLabelStyle, VerticalAlignment: Center, Wrap: true);
  }

  $C.@TextField #Count {
    @Anchor = (Width: 90, Right: 16, Top: 3);
  }

  // The team's color, as on the Teams page; hidden for no team. Its place stays taken, so a row with no team keeps its
  // team picker and Remove button in line with the others (playtest screenshot, 2026-10-17).
  Group {
    Anchor: (Width: 26, Height: 26, Top: 9, Right: 8);
    Group #Swatch {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      Background: #808080;
    }
  }

  $C.@DropdownBox #Team {
    Anchor: (Width: 150, Top: 6, Right: 16, Height: 32);
  }

  // The equipment kit this entry's mobs spawn with (Kits); "-" = none.
  $C.@DropdownBox #Kit {
    Anchor: (Width: 150, Top: 6, Right: 12, Height: 32);
  }

  $C.@SmallSecondaryTextButton #Remove {
    @Text = %server.mobbattle.panel.button.remove;
    @Anchor = (Width: 110, Top: 6);
  }
}
