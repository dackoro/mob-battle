  // 3+ teams: one column per team (VsScreen columns)
  Group #Cols {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Visible: false;
    Group #Cols3 {
      Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
      LayoutMode: Left;
      Visible: false;
      Group #C3P0 {
        FlexWeight: 1;
        // the column rises from the bottom of the screen (user, 2026-10-16: they popped in): #..Pad shrinks and #..Body
        // grows (FlexWeights set by VsScreen, never 0: a 0 takes its content's size); the content hangs from the
        // body's top, so it moves up with it (below the screen = unseen)
        Group #C3P0In {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Visible: false;
          LayoutMode: Top;
          Group #C3P0Pad { FlexWeight: 1000; }
          Group #C3P0Body {
            FlexWeight: 1;
            Background: #000000;
            Group {
              Anchor: (Left: 0, Right: 0, Top: 0, Height: 1080);
              // the picture, already cut to the column's width by VsScreen (COLUMN_CROP)
              Group {
                Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 0); }
                    Group {
                      Anchor: (Height: 1100);
                      AssetImage #C3P0T0 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
                  }
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 145); }
                    Group {
                      Anchor: (Height: 935);
                      AssetImage #C3P0T1 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
