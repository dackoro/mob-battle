                LayoutMode: Top;
                Group {
                  Anchor: (Height: 130);
                  LayoutMode: Top;
                  Padding: (Left: 16, Top: 14, Right: 8);
                  Label #C8P6Tag {
                    Anchor: (Height: 32);
                    Style: (FontSize: 24, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                            HorizontalAlignment: Start, VerticalAlignment: Center);
                  }
                  Label #C8P6Name {
                    Anchor: (Height: 60);
                    Style: (FontSize: 24, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                            HorizontalAlignment: Start, VerticalAlignment: Center);
                  }
                }
              }
            }
          }
        }
      }
      Group #C8P7 {
        FlexWeight: 1;
        // the column rises from the bottom of the screen (user, 2026-10-16: they popped in): #..Pad shrinks and #..Body
        // grows (FlexWeights set by VsScreen, never 0: a 0 takes its content's size); the content hangs from the
        // body's top, so it moves up with it (below the screen = unseen)
        Group #C8P7In {
          Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
          Visible: false;
          LayoutMode: Top;
          Group #C8P7Pad { FlexWeight: 1000; }
          Group #C8P7Body {
            FlexWeight: 1;
            Background: #000000;
            Group {
              Anchor: (Left: 0, Right: 0, Top: 0, Height: 1080);
              // the picture, already cut to the column's width by VsScreen (COLUMN_CROP)
              Group {
                Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 80); }
                    Group {
                      Anchor: (Height: 1000);
                      AssetImage #C8P7T0 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
                  }
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 230); }
                    Group {
                      Anchor: (Height: 850);
                      AssetImage #C8P7T1 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
                  }
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 360); }
                    Group {
                      Anchor: (Height: 720);
                      AssetImage #C8P7T2 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
                  }
                  Group {
                    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                    LayoutMode: Top;
                    Group { Anchor: (Height: 480); }
                    Group {
                      Anchor: (Height: 600);
                      AssetImage #C8P7T3 { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); Visible: false; }
                    }
                  }
              }
              // a mob with no column picture yet (its square picture or icon, user 2026-10-16: an icon stretched to the
              // column's height): square, as wide as the column, standing on its bottom
              Group {
                Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                LayoutMode: Top;
                Group { Anchor: (Height: 840); }
                Group {
                  Anchor: (Height: 240);
                  LayoutMode: Center;
                  AssetImage #C8P7Sq { Anchor: (Width: 240, Height: 240); Visible: false; }
                }
              }
              AssetImage #C8P7Over { Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0); }
              Group {
                Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
                LayoutMode: Top;
                Group {
                  Anchor: (Height: 130);
                  LayoutMode: Top;
                  Padding: (Left: 16, Top: 14, Right: 8);
                  Label #C8P7Tag {
                    Anchor: (Height: 32);
                    Style: (FontSize: 24, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                            HorizontalAlignment: Start, VerticalAlignment: Center);
                  }
                  Label #C8P7Name {
                    Anchor: (Height: 60);
                    Style: (FontSize: 24, FontName: "Secondary", TextColor: #ffffff, RenderBold: true, RenderUppercase: true,
                            HorizontalAlignment: Start, VerticalAlignment: Center);
                  }
                }
              }
            }
          }
        }
      }
    }
  }

  Group #Flash {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    Background: #ffffff(0.7);
    Visible: false;
  }

  // the kind's title right under the column headers, over the space above the faces (user, 2026-10-16: in the middle
  // it covered them)
  Group #ColTitle {
    Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
    LayoutMode: Top;
    Visible: false;
    Group {
      Anchor: (Height: 77, Top: 136);
      LayoutMode: Center;
      AssetImage #ColKindTitle { Anchor: (Width: 608, Height: 77); }
    }
  }
}
