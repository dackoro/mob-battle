$C = "../../Common.ui";

// One rune line of the mob (EquipPage, Runes tab), as the game's rune bench: the main rune (#H0) and two supports
// (#H1, #H2), each drawn as the game draws items (#I0..#I2); #M0..#M2 mark the hole the gallery fills.
Group {
  LayoutMode: Left;
  Anchor: (Height: 84, Bottom: 6);

  Label #Label {
    Anchor: (Width: 92);
    Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center, Wrap: true);
  }

  Group {
    LayoutMode: Top;
    Anchor: (Width: 76, Right: 8);

    ItemSlotButton #H0 {
      Anchor: (Height: 76);
      LayoutMode: Full;
      Padding: 3;
      Style: (
        Default: (
          Background: #1c2835,
        ),
        Hovered: (
          Background: #2c3c4c,
        ),
        Pressed: (
          Background: #a08040,
        ),
        Disabled: (
          Background: #14181d,
        ),
        Sounds: $C.@ButtonSounds,
      );

      ItemSlot #I0 {
        Anchor: (Full: 0);
        ShowQualityBackground: true;
        Visible: false;
      }
    }

    Group #M0 {
      Anchor: (Height: 4, Top: 2);
      Background: #ffd23e;
      Visible: false;
    }
  }

  Group {
    LayoutMode: Top;
    Anchor: (Width: 62, Top: 7, Right: 6);

    ItemSlotButton #H1 {
      Anchor: (Height: 62);
      LayoutMode: Full;
      Padding: 3;
      Style: (
        Default: (
          Background: #1c2835,
        ),
        Hovered: (
          Background: #2c3c4c,
        ),
        Pressed: (
          Background: #a08040,
        ),
        Disabled: (
          Background: #14181d,
        ),
        Sounds: $C.@ButtonSounds,
      );

      ItemSlot #I1 {
        Anchor: (Full: 0);
        ShowQualityBackground: true;
        Visible: false;
      }
    }

    Group #M1 {
      Anchor: (Height: 4, Top: 2);
      Background: #ffd23e;
      Visible: false;
    }
  }

  Group {
    LayoutMode: Top;
    Anchor: (Width: 62, Top: 7);

    ItemSlotButton #H2 {
      Anchor: (Height: 62);
      LayoutMode: Full;
      Padding: 3;
      Style: (
        Default: (
          Background: #1c2835,
        ),
        Hovered: (
          Background: #2c3c4c,
        ),
        Pressed: (
          Background: #a08040,
        ),
        Disabled: (
          Background: #14181d,
        ),
        Sounds: $C.@ButtonSounds,
      );

      ItemSlot #I2 {
        Anchor: (Full: 0);
        ShowQualityBackground: true;
        Visible: false;
      }
    }

    Group #M2 {
      Anchor: (Height: 4, Top: 2);
      Background: #ffd23e;
      Visible: false;
    }
  }
}
