$C = "../Common.ui";

// Equipment Wand panel (EquipPage.java). Left: the mob's six slots (Equip/EquipRow.ui), click one to edit it.
// Right: search, filters and a gallery of items (Equip/GridCell.ui, as the game's barter grid); a click puts it on.
$C.@DecoratedContainer {
  @CloseButton = true;
  Anchor: (Width: 1120, Height: 840);

  #Title {
    Group {
      LayoutMode: Left;
      $C.@Title {
        @Text = %server.mobbattle.equip.title;
        @Alignment = Center;
      }
    }
  }

  #Content {
    LayoutMode: Left;

    Group #Left {
      Anchor: (Width: 360);
      LayoutMode: Top;
      Padding: (Right: 12);

      Label #Mob {
        Anchor: (Height: 30, Bottom: 6);
        Text: "";
        Style: (FontSize: 20, TextColor: #ffffff, RenderBold: true, VerticalAlignment: Center);
      }

      Group #Rows {
        LayoutMode: Top;
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Top: 6);

        $C.@SecondaryTextButton #Copy {
          @Anchor = (Width: 170, Right: 8);
          @Text = %server.mobbattle.equip.copy;
        }
        $C.@SecondaryTextButton #Paste {
          @Anchor = (Width: 170);
          @Text = %server.mobbattle.equip.paste;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Top: 6);

        $C.@SecondaryTextButton #Restore {
          @Anchor = (Width: 170, Right: 8);
          @Text = %server.mobbattle.equip.restore;
        }
        $C.@SecondaryTextButton #ClearAll {
          @Anchor = (Width: 170);
          @Text = %server.mobbattle.equip.clearall;
        }
      }

      // Kits: save this mob's set under a name, or put a saved kit on it.
      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Top: 12);

        $C.@TextField #KitName {
          @Anchor = (Width: 170, Top: 4, Right: 8);
          PlaceholderText: %server.mobbattle.equip.kitname;
        }
        $C.@SecondaryTextButton #SaveKit {
          @Anchor = (Width: 170);
          @Text = %server.mobbattle.equip.savekit;
        }
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 40, Top: 6);

        $C.@DropdownBox #KitPick {
          Anchor: (Width: 170, Top: 4, Height: 32, Right: 8);
        }
        $C.@SecondaryTextButton #ApplyKit {
          @Anchor = (Width: 170);
          @Text = %server.mobbattle.equip.applykit;
        }
      }

      Label #Status {
        Anchor: (Top: 8);
        Text: "";
        Style: (FontSize: 13, TextColor: #ffd23e, Wrap: true);
      }
    }

    Group {
      Anchor: (Width: 1);
      Background: #2b3542;
    }

    Group #Right {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Left: 12);

      Label #Editing {
        Anchor: (Height: 30);
        Text: "";
        Style: (FontSize: 16, TextColor: #ffd23e, RenderBold: true, VerticalAlignment: Center);
      }

      Group {
        LayoutMode: Left;
        Anchor: (Height: 44);

        $C.@TextField #Search {
          @Anchor = (Width: 300, Top: 6, Right: 12);
          PlaceholderText: %server.mobbattle.equip.search;
        }

        Label #Count {
          FlexWeight: 1;
          Text: "";
          Style: (FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center, Wrap: true);
        }
      }

      Group #Filters {
        LayoutMode: Top;
        Anchor: (Bottom: 4);
      }

      Group #GridBox {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;

        Group #Grid {
          LayoutMode: LeftCenterWrap;
        }
      }
    }
  }
}
