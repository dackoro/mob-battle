// Mob Battle all vs one card (FocusCard.java): the lone target and its stats, the attackers below, on the right in the scoreboard's place (it replaces the board).
// Same look as DuelCard.ui. A malformed property makes the client reject the whole HUD, so change one thing at a time.
// Under the cinema bars (CinemaBars.shift, 2026-10-16, user): #ShiftBar takes the band's height and #ShiftPad
// hides, so the card sits just under the top band while a camera films; without bars it is where it always was.
Group #Shift {
  Anchor: (Left: 0, Right: 0, Top: 0, Bottom: 0);
  LayoutMode: Top;

  Group #ShiftBar { FlexWeight: 0; }
  Group #ShiftRest {
    FlexWeight: 1000;
    LayoutMode: Top;

    Group #ShiftPad { Anchor: (Height: 94); }
    Group #ShiftSlot {
      FlexWeight: 1;

      Group {
        Anchor: (Right: 24, Top: 170, Width: 270);
        LayoutMode: Top;

        Group #Header {
          Anchor: (Height: 34);
          Background: (TexturePath: "../Common/ContainerHeader.png", HorizontalBorder: 50, VerticalBorder: 0);
          Padding: (Top: 6);

          Label #Title {
            Text: %server.mobbattle.hud.allvsone;
            Style: (FontSize: 14, FontName: "Secondary", TextColor: #ffd23e, RenderBold: true, RenderUppercase: true,
                    HorizontalAlignment: Center, VerticalAlignment: Center);
          }
        }

        Group #Body {
          Anchor: (Height: 246);
          LayoutMode: Top;
          Padding: (Horizontal: 16, Vertical: 8);
          Background: (TexturePath: "../Common/ContainerPatch.png", Border: 23);

          Label #Name { Anchor: (Height: 22); Text: ""; Style: (FontSize: 15, RenderBold: true, RenderUppercase: true); }
          Label #Health { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #Attack { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #Defense { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #Size { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #Kills { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }

          Label #Vs { Anchor: (Height: 22); Text: %server.mobbattle.hud.vs; Style: (FontSize: 14, TextColor: #96a9be, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center); }

          Label #Left { Anchor: (Height: 20); Text: ""; Style: (FontSize: 14, RenderBold: true, RenderUppercase: true); }
          Label #TeamHealth { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #TopName { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
          Label #TopLine { Anchor: (Height: 17); Text: ""; Style: (FontSize: 12, RenderBold: true); }
        }
      }
    }
  }
}
