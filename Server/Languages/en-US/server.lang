items.MobBattle_ChaosWand.name = Chaos Wand
items.MobBattle_ChaosWand.description = Left click a mob: every mob around attacks it.\nRight click: battle royale around the mob you aim at (or you); last one standing wins.\nArea: /mobbattle arearadius, /mobbattle areastyle, /mobbattle areacolor.
items.MobBattle_CleanseWand.name = Cleanse Wand
items.MobBattle_CleanseWand.description = Left click an entity: remove every effect and undo a morph.\nHold left: cleanse every mob and player around you.
items.MobBattle_EffectWand.name = Effect Wand
items.MobBattle_EffectWand.description = Left click an entity: give it the selected effect (default Burn).\nRight click: next effect.\nAny effect: /mobbattle wandeffect <id>.
items.MobBattle_HealWand.name = Heal Wand
items.MobBattle_HealWand.description = Left click an entity: restore it to full health.
items.MobBattle_DebugWand.name = Debug Wand
items.MobBattle_DebugWand.description = Admins only. Left click: dump everything about a mob. Then follows its target, state and health for a while. Right click: stop following.
items.MobBattle_KillWand.name = Kill Wand
items.MobBattle_KillWand.description = Left click an entity: kill it instantly.
items.MobBattle_MorphWand.name = Morph Wand
items.MobBattle_MorphWand.description = Right click a mob: copy its model.\nLeft click a mob: give it that model (it keeps its AI and attacks).\nHold left: every mob around takes it. Hold right: the mobs around swap models.\nAny model: /mobbattle morph <model>. Undo: Cleanse Wand or /mobbattle morph reset.
items.MobBattle_SummonWand.name = Summon Wand
items.MobBattle_SummonWand.description = Left click a mob: add its type to the summon list (again: remove it).\nRight click: summon the whole list around you.\nCounts and teams: /mobbattle summon.
items.MobBattle_TeamWand.name = Team Wand
items.MobBattle_TeamWand.description = Left click a mob: add it to the current team (again: remove it).\nRight click in the air: next team.\nRight click a mob: start the battle; last team standing wins.\nTeams and rules: /mobbattle teams.
items.MobBattle_Wand.name = Battle Wand
items.MobBattle_Wand.description = Left click a mob, then another: they fight each other.\nRight click: clear the selection.
items.MobBattle_ArmyWand.name = Army Wand
items.MobBattle_ArmyWand.description = Left click a mob: it joins your army (click again: it leaves).\nYour army attacks whoever you hit and whoever hits you, and never hurts you.\nRight click: disband your army.
mobbattle.timer.duel = Duel
mobbattle.timer.allvsone = Everyone vs one
mobbattle.timer.royale = Battle Royale
mobbattle.timer.teams = Team Battle
items.MobBattle_SnapWand.name = Snap Wand
items.MobBattle_SnapWand.description = Left click: half of the fighters turn to dust, picked at random.\nClick a mob: its battle. Click the air: your battles, or the mobs around you.\nHalf of everyone or half of each side: /mobbattle snapMode.
items.MobBattle_BuffWand.name = Buff Wand
items.MobBattle_BuffWand.description = Left click a mob or player: one more buff stack (/mobbattle buff wand). Right click: take it off.
