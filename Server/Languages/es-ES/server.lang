mobbattle.help.main.9 = teams - Varita de Equipos, equipos y aspecto de equipo
mobbattle.help.main.10 = summon - lista de la Varita de Invocación
mobbattle.help.main.11 = morph - varitas de Transformación, Efectos y Muerte, y efectos de varitas
mobbattle.help.main.12 = presets - default, fight, effects, debug, cinematic, los tuyos
mobbattle.help.main.13 = config - el panel de ajustes (todos los ajustes, listas, presets, herramientas)
mobbattle.help.main.14 = server - permisos, archivo de configuración del servidor y recarga
mobbattle.help.wands.1 = Varitas (/mobbattle give)
mobbattle.help.wands.2 = Varita de Batalla: haz clic en un mob y luego en otro: pelean
mobbattle.help.wands.3 = agáchate + clic en un mob: ese mob contra ti; también puedes pulsar jugadores (playerFights duel on)
mobbattle.help.wands.4 = Varita de Ejército: clic izquierdo en un mob: se une a tu ejército (otro clic: se va); clic derecho: disolver
mobbattle.help.wands.5 = tu ejército te sigue, te defiende y ataca lo que golpeas (jugadores también)
mobbattle.help.wands.6 = Varita del Caos: clic izquierdo en un mob (o jugador): todos lo atacan
mobbattle.help.wands.7 = clic derecho: battle royale, gana el último en pie
mobbattle.help.wands.8 = Varita de Equipos: el clic izquierdo añade un mob (o jugador) al equipo actual
mobbattle.help.wands.9 = clic derecho al aire: siguiente equipo; clic derecho en un mob: empezar
mobbattle.help.wands.10 = Varita de Invocación: clic izquierdo en un mob añade su tipo a la lista
mobbattle.help.wands.11 = clic derecho: invoca toda la lista
mobbattle.help.wands.12 = Varita de Transformación: clic derecho copia un modelo, clic izquierdo lo aplica
mobbattle.help.wands.13 = Curación / Muerte / Efectos / Limpieza: clic izquierdo en cualquier entidad
mobbattle.help.wands.14 = clic derecho de la Varita de Efectos: siguiente efecto; Varita de Muerte: arranca el alma y luego muere (botín con killLoot on)
mobbattle.help.wands.15 = Varita del Chasquido: la mitad de los mobs se vuelve polvo (los de la batalla del mob pulsado, o todos los mobs a menos de snapRadius, peleen o no)
mobbattle.help.wands.16 = Varita de Depuración (admin): clic izquierdo en un mob: informe completo (chat, registro del servidor, archivo en debug/), luego su objetivo, estado de IA, salud y efectos durante debugTrack segundos en el mismo archivo; clic derecho: dejar de seguirlo
mobbattle.help.titles.1 = Títulos y cámaras (globales, o por tipo: <opción> <duel|allVsOne|royale|teams|all> <valor>; <tipo> default = sigue el global)
mobbattle.help.titles.2 = countdown <segundos> - 3, 2, 1 antes de que empiece una pelea (0 = al instante)
mobbattle.help.titles.34 = readyTime <segundos>|off - tiempo para ir a tu sitio antes de la pantalla VS y la cuenta: un número grande cuenta para ti, los luchadores esperan y agacharte empieza ya; nunca si peleas tú en ella (0-60, por defecto apagado; también por tipo de batalla)
mobbattle.help.titles.3 = startTitle on|off - título cuando empieza una pelea
mobbattle.help.titles.4 = winTitle on|off - título con el ganador
mobbattle.help.titles.5 = titleStyle default|major|goblinBreach|voidEviction|random
mobbattle.help.titles.6 = titleScope owner|nearby|world - quién ve los títulos de pelea
mobbattle.help.titles.7 = cameraScope owner|nearby|world - quién ve las cámaras (un luchador nunca recibe la intro)
mobbattle.help.titles.8 = camera on|off - cámara de intro durante la cuenta atrás (o cameraTime)
mobbattle.help.titles.9 = cameraStyle auto|orbit|duel|showcase|teams|focus|drone|spotlight - auto: duelo western, allVsOne foco, equipos y royale spotlight
mobbattle.help.titles.10 = cameraTime <segundos> - duración de la cámara de intro; 0 = la cuenta atrás; >0 graba incluso con countdown 0
mobbattle.help.titles.11 = cameraShots <n> - showcase y spotlight: a cuántos luchadores muestran de cerca (de 1 a maxMobs; un plano de showcase necesita 1,2 s de cameraTime, uno de spotlight 1,1 s)
mobbattle.help.titles.12 = endCamera off|winner|lastHit - graba al ganador o a quien dio el golpe final, con su número de muertes
mobbattle.help.titles.13 = endCameraTime <segundos> - duración de la cámara final
mobbattle.help.titles.14 = agáchate mientras suena una cámara, o skipCamera, para terminarla; una intro también termina cuando acaba su batalla
mobbattle.help.titles.15 = skipCamera - termina ahora tu cámara de intro o final
mobbattle.help.titles.16 = autoWatch on|off - empieza a observar tú solo cuando arranca la batalla (tras la cuenta atrás), para los jugadores de cameraScope; termina la intro (por defecto off)
mobbattle.help.titles.17 = music on|off|<pista> - música de batalla desde la cuenta atrás hasta el final
mobbattle.help.titles.18 = runes on|off - runas de invocación y marcas de luchadores al empezar
mobbattle.help.titles.19 = p. ej. countdown royale 5, cameraStyle royale showcase, camera duel off, endCamera all winner
mobbattle.help.titles.20 = cameraBars off|slim|classic|wide - bandas negras de película arriba y abajo mientras suena una cámara de intro o final (por defecto classic)
mobbattle.help.titles.21 = cameraBlur off|soft|strong - desenfoca lo que queda delante y detrás de lo que filma cada plano (por defecto soft)
mobbattle.help.titles.22 = autoFilm on|off - quienes ven las cámaras reciben la película de la batalla (ver film) desde que empieza, tras la intro, hasta que termina; gana a autoWatch (por defecto off)
mobbattle.help.titles.30 = vsScreen on|off - una pantalla VS estilo Smash antes de la cuenta atrás: los dos lados entran con las imágenes de sus luchadores (grandes, o en multitud si el lado es grande; una columna por equipo con 3 equipos o más) y un VS grande. Suma 3 s a cualquier cuenta atrás mayor que 0; la cámara de intro conserva todo su tiempo después (por defecto on)
mobbattle.help.titles.31 = vsTeamReps 1|2 - pantalla VS con 3 equipos o más: luchadores por equipo (una columna cada uno) cuando hay 4 equipos o menos (por defecto 2)
mobbattle.help.titles.23 = filmPlayerShots <0-100> - % de planos de la película que te muestran mirando (por defecto 20); filmShotTime <3-60> - segundos por plano (por defecto 8)
mobbattle.help.titles.24 = filmShotVariation <0-90> - cada plano dura ese % más o menos al azar (por defecto 25); filmPace <25-300> - cuánto se mueve la cámara en un plano, % (por defecto 100)
mobbattle.help.titles.25 = filmTransition cut|glide - saltar al siguiente plano o deslizarse hasta él (por defecto cut); filmShots all|battle|<lista> - atajo de filmShot: los planos de la lista encendidos y todos los demás a 0 (battle = todos menos los planos tuyos); los 14 planos: wide, track, arc, pushin, closeup, landscape, playerback, playerclose, zenith, spiral, telephoto, descent, groundrise, profile
mobbattle.help.titles.26 = cameraHud hide|show - oculta la interfaz del juego (barra de objetos, brújula, barra del jefe...) mientras filma una cámara, dejando el chat y los títulos (por defecto hide)
mobbattle.help.titles.29 = cameraFace on|off - los primeros planos se ponen delante de la cara del mob mire donde mire; off = hacia la batalla o el rival (por defecto on)
mobbattle.help.titles.33 = watchTransition cut|glide - cómo pasa la cámara de observar a otro luchador: de golpe, o viajando hasta él a través de los bloques (por defecto glide); watchAutoSwitch <3-600>|off - segundos en cada luchador antes de que el watch pase solo al siguiente, como un clic derecho (por defecto off); endSlowMo <5-99>|off - cámara lenta tras el golpe final, velocidad del mundo en porcentaje; frena todo el mundo, no se aplica si hay otra batalla en él (por defecto off); endSlowMoTime <1-20> - sus segundos (por defecto 3)
mobbattle.help.titles.28 = filmShot <plano> <0-300> - cada cuánto usa la película ese plano, % de lo normal: 0 = nunca, 200 = el doble (por defecto: 100, landscape y groundrise 50, zenith 40, spiral 80, telephoto y descent 70; filmShots <lista> = esos encendidos, el resto apagados; filmShots default = todos a su valor por defecto)
mobbattle.help.titles.27 = filmWideShots <0-100> - % de planos de la película que son generales y lejanos, para ver de lejos los ataques grandes; +15 con un mob de más de 4 bloques (por defecto 30)
mobbattle.help.titles.32 = filmStyle default|battle|action|cinematic - todos los ajustes de la película de una vez: battle = la pelea siempre a la vista, poco de ti; action = cerca de los luchadores y sus ataques; cinematic = planos abiertos, lentos y deslizados; default = como viene (luego puedes cambiar cada valor)
mobbattle.help.chaos.1 = Área del Caos
mobbattle.help.chaos.2 = areaStyle border|disc|discBorder|wall|off - qué dibujan áreas y arenas: border (solo el brillo del borde, por defecto), disc (un disco en el suelo), discBorder (ambos), wall (disco + muro translúcido) u off
mobbattle.help.chaos.3 = areaColor <color>|random - color de la paleta
mobbattle.help.chaos.4 = battleWaveTravel on|off - ondas de Chasquido, royale y todos contra uno: cada mob es alcanzado cuando el anillo llega a él (por defecto off)
mobbattle.help.chaos.5 = battleWaveGroundOnly on|off - las ondas de Chasquido, royale y todos contra uno solo alcanzan mobs cerca del suelo (por defecto off)
mobbattle.help.chaos.6 = areaRadius <bloques> - tamaño del área
mobbattle.help.chaos.7 = areaHeight <bloques> - altura del muro de la zona (3-512)
mobbattle.help.chaos.8 = areaOnlyWand on|off - solo tú, y solo mientras llevas la varita
mobbattle.help.chaos.9 = maxMobs <n> - mobs por clic y por invocación (por defecto 200, 2-{max}; más de {warn} puede dar lag al servidor)
mobbattle.help.battles.1 = Batallas
mobbattle.help.battles.2 = debug - instantáneas de combate de los 4 NPC más cercanos a menos de 20 bloques; registro de golpes durante 10 s
mobbattle.help.battles.3 = debugLog on|off - decisiones de batalla (config, arena, elección de objetivo, puntuaciones de salud, ganador) en el registro del servidor
mobbattle.help.battles.4 = debugRecord on|off - (admin) guarda en memoria los últimos 5 min de registro y líneas [debug], ajuste guardado (por defecto off)
mobbattle.help.battles.5 = debugDump - (admin) escribe lo que guardó el grabador en debug/record_<hora>.txt
mobbattle.help.battles.6 = duelMode exclusive|accumulate - sustituir un duelo o mantener peleas conectadas
mobbattle.help.battles.7 = buff lone|streak|champion size|health|damage|defense|speed|all|off <porcentaje> - buffs de batalla: lone = objetivo de todos contra uno, streak = por muerte (hasta buff streak maxKills, por defecto 5), champion = los ganadores hasta que mueren o los limpian (por defecto 0 = ninguno)
mobbattle.help.battles.8 = buff wand size|health|damage|defense|speed|all|off <porcentaje> - Varita de Buff, por clic (por defecto size 10, health 20, damage 10, defense 5; se acumulan hasta buff wand maxStacks, por defecto 5)
mobbattle.help.battles.9 = buff lone|streak|champion|wand heal on|off - ese buff también rellena la salud (lone: cura al objetivo al elegirlo, incluso sin buff lone); por defecto off: la salud mantiene la misma proporción del nuevo máximo
mobbattle.help.battles.10 = buff crown gold|<color>|off - corona en mobs de streak, champion y Varita de Buff (por defecto off: la corona es del objetivo de todos contra uno)
mobbattle.help.battles.11 = buff unit percent|multiplier - cómo se muestran y escriben los valores de buff: percent (por defecto, +100% = doble) o multiplier (x2 = doble, con decimales como x1.5; defensa x2 = mitad del daño recibido). x2 o 50% siempre funcionan
mobbattle.help.battles.12 = buff sizeMax <50-9900> - máximo de tamaño extra en un mob o jugador, todos los buffs juntos (por defecto 200 = x3; más funciona pero no se recomienda: los jugadores grandes no caben bajo techos y su cámara acaba dentro de los bloques). Los saltos crecen con el tamaño
mobbattle.help.battles.13 = buff sizeSpeed off|natural|strong|full - cuánto acelera un buff de tamaño: natural = x4 el doble de rápido (por defecto), strong = x4 2,8 veces, full = x4 4 veces (los pasos coinciden con el suelo)
mobbattle.help.battles.14 = buff sizeJump off|natural|strong|full - cuánto sube el salto un buff de tamaño: natural = la altura crece con el tamaño (por defecto)
mobbattle.help.battles.15 = fightLaser on|off - láser entre luchadores al empezar (también por tipo)
mobbattle.help.battles.16 = fightLaserColor <color>|random - color del láser (paleta; random = uno vistoso en cada pelea)
mobbattle.help.battles.17 = battleIsolation <duel|allVsOne|royale|teams|all> on|off - los mobs de fuera no pueden herir a los mobs de la batalla
mobbattle.help.battles.18 = selfDefense <duel|allVsOne|royale|teams|all> on|off - un mob golpeado por un enemigo que no es su objetivo se vuelve contra él (por defecto on)
mobbattle.help.battles.19 = friendlyFire <allVsOne|teams|all> on|off - los aliados se hieren entre sí
mobbattle.help.battles.20 = playerFights <duel|allVsOne|royale|teams|all> on|off - los jugadores también pelean (por defecto on, nunca en Creativo):
mobbattle.help.battles.21 = las varitas funcionan con jugadores igual que con mobs; agáchate + Varita de Batalla en un mob: él contra ti
mobbattle.help.battles.22 = chaos me - todos los mobs del área te atacan (playerFights allVsOne on)
mobbattle.help.battles.23 = battlePvp on|off - los jugadores enemigos de una batalla se hieren entre sí aunque el PvP del mundo esté desactivado
mobbattle.help.battles.24 = arena <tipo|all> on|show|wall|off - área dibujada toda la pelea (show), nadie sale de ella (wall), ambas (on)
mobbattle.help.battles.25 = arenaSize <bloques>|auto - radio de la arena de duelos y batallas de equipos (Varita del Caos: areaRadius)
mobbattle.help.battles.26 = timer <tipo|all> <tiempo>|off - límite de tiempo con caja de temporizador: 90, 2m, 1m30s, --minutes=2 --seconds=30
mobbattle.help.battles.27 = scoreboard <tipo|all> on|off - HUD con una fila por bando: equipos vivos/total y muertes, salud del objetivo contra atacantes, royale restantes + mejores asesinos, salud del duelo (por defecto teams on)
mobbattle.help.battles.28 = wave <summon|snap|slam|allVsOne|royale|all> <color|off> - color de la onda de choque en el suelo por acción (colores de la paleta; por defecto summon verde, snap blanco, slam/royale morado, allVsOne amarillo)
mobbattle.help.battles.29 = mobFx <duel|allVsOne|attackers|royale|all> <color|default|off> - tinte, aura y runa en los mobs de batalla (default = aspecto original; royale morado por defecto)
mobbattle.help.battles.30 = crown gold|<color>|off - todos contra uno: corona con rayos de luz sobre el objetivo durante 20 s (por defecto gold)
mobbattle.help.battles.31 = cleanseColor <color> - aspecto de la Varita de Limpieza: luz desde arriba, estallido, aura y runa (por defecto blanco)
mobbattle.help.battles.32 = cleanseArea on|off - Varita de Limpieza: mantén clic izquierdo para limpiar a todos los mobs y jugadores a tu alrededor (por defecto on)
mobbattle.help.battles.33 = cleanseRadius <bloques> - alcance de la limpieza con clic mantenido (por defecto 12)
mobbattle.help.battles.34 = cleanseAreaSelf on|off - la limpieza con clic mantenido también te limpia a ti (por defecto off)
mobbattle.help.battles.35 = healLight <color>|off - Varita de Curación: baja una luz del cielo y la curación llega con ella (por defecto verde; off = al instante)
mobbattle.help.battles.36 = buffLook shimmer|runes|off - aspecto de un mob con buff mientras dura: shimmer (venas, llamas en los ojos, runas; por defecto), runes (solo llamas en los ojos y runas) u off
mobbattle.help.battles.37 = buffLight buff|<color>|off - Varita de Buff: baja una luz del cielo y el buff llega con ella (por defecto buff = en buffColor; off = al instante)
mobbattle.help.battles.38 = buffColor <color> - aspecto del buff: la marca y el remolino de la Varita de Buff, y el shimmer (venas, llamas en los ojos, runas) de los mobs con buff (por defecto morado; quitar el buff es gris)
mobbattle.help.battles.39 = borderColor <summon|snap|slam|allVsOne|royale|all> <color|off|area> - color del brillo del borde por acción (area = areaColor; por defecto summon verde, allVsOne amarillo, royale morado, snap/slam off: un color dibuja un anillo a su alcance)
mobbattle.help.battles.40 = arenaShrink <tipo|all> on|off - la arena se cierra como la zona de un battle royale (por defecto: royale on)
mobbattle.help.battles.41 = arenaShrinkTo <bloques> - radio final de una arena que se cierra (por defecto 15)
mobbattle.help.battles.42 = arenaShrinkTime <90|2m|1m30s> - lo que tarda en cerrarse una arena cuando la batalla no tiene temporizador (por defecto 2m)
mobbattle.help.battles.43 = unstick on|off - un mob atascado 10 s en otro nivel (cueva, montaña; los voladores 20 s, muros también) aparece junto a su oponente
mobbattle.help.battles.44 = standoffTime <segundos>|off - un mob en el nivel de su oponente que pasa ese tiempo sin acercarse, sin golpear nada y sin que le golpeen es empujado hacia él (0-3600, por defecto 15, 0 = off)
mobbattle.help.battles.45 = passiveWinIgnore <rol,rol*,...>|none - roles que nunca dejan que passiveWin termine una batalla mientras uno siga vivo, p. ej. muñecos de entrenamiento (por defecto Test_Dummy*; * = cualquier final)
mobbattle.help.battles.46 = idleEnd <segundos>|off - una batalla donde ningún luchador hiere a un enemigo durante este tiempo termina en empate (0-3600, por defecto 150 = 2,5 min, 0 = off)
mobbattle.help.battles.47 = passiveWin <segundos>|off - cuando solo un bando puede seguir luchando (el resto son mobs pasivos), gana tras este tiempo sin golpes; nadie puede luchar = empate; abajo a la izquierda sale un aviso (0-3600, por defecto 15, 0 = off)
mobbattle.help.battles.48 = duelCard on|off - tarjeta de solo lectura con las estadísticas de ambos luchadores (salud, ataque, defensa, tamaño, con sus buffs) en un duelo 1 contra 1, desde la cuenta atrás hasta el final (por defecto off)
mobbattle.help.battles.49 = focusCard on|off - tarjeta de solo lectura en un todos contra uno: estadísticas del objetivo (salud, ataque, defensa, tamaño, muertes) y atacantes restantes, su salud y quien más daño hace (por defecto off)
mobbattle.help.battles.50 = judgeBy <tipo|all> health|damage|kills|mix - qué puntúa timeUp health/judge: % de salud restante (por defecto), parte del daño o de las muertes (por luchador, para que los bandos grandes no ganen por tamaño), o las tres promediadas
mobbattle.help.battles.51 = tieBreak [tipo] damage|kills|random|draw - quién gana cuando la puntuación de judgeBy está igualada al acabar el tiempo (el mismo que judgeBy, damage o kills, toma el otro; por defecto damage, también por tipo de batalla)
mobbattle.help.battles.52 = killTieBreak [tipo] damage|alive|first|shared - orden de la tabla de muertes para luchadores con las mismas muertes: más daño hecho (por defecto), los que siguen en pie primero, quien llegó antes, o un puesto compartido (también por tipo de batalla)
mobbattle.help.battles.53 = snap - la mitad de los mobs a menos de snapRadius (peleen o no) se vuelve polvo, como la Varita del Chasquido
mobbattle.help.battles.54 = snapMode global|team - la mitad de todos, o la mitad de cada bando
mobbattle.help.battles.55 = snapPercent <1-100> - parte que se vuelve polvo (por defecto 50)
mobbattle.help.battles.56 = snapTime <1-600> - segundos en los que se vuelven polvo (por defecto 5)
mobbattle.help.battles.57 = snapHitDelay <ms> - Varita del Chasquido: espera tras el clic hasta que el golpe impacta y se produce el chasquido (por defecto 310, 0-2000)
mobbattle.help.battles.58 = snapRadius <bloques> - alcance del chasquido sin batallas (por defecto 60, independiente de areaRadius)
mobbattle.help.battles.59 = snapPlayers on|off - el chasquido también se lleva a los jugadores a su alcance (nunca a ti, nunca en Creativo; por defecto on)
mobbattle.help.battles.60 = timerStyle custom|portal - nuestra propia caja de temporizador (por defecto) o la caja del portal del Vacío del juego
mobbattle.help.battles.61 = timeUp <tipo|all> draw|kill|continue|health|judge - cuando termina el temporizador (health: gana la mejor puntuación de judgeBy, por defecto más salud en %; judge: y los perdedores mueren, los ganadores se curan)
mobbattle.help.battles.62 = watch - observa la batalla en curso más cercana (primero la tuya), incluso después de empezar: la cámara sigue a un luchador
mobbattle.help.battles.63 = clic derecho: luchador más cercano (aún no visto), clic izquierdo: volver al anterior, ratón: girar la cámara, Q o watch exit: salir
mobbattle.help.battles.64 = cuando muere el luchador la cámara pasa a su asesino; una tarjeta muestra sus estadísticas; tras la batalla vuelves
mobbattle.help.battles.74 = film - una cámara de película lenta filma la batalla en curso más cercana (la tuya primero) hasta que termina: planos generales, paneos, arcos, acercamientos y planos tuyos mirando; agáchate o film exit para parar
mobbattle.help.battles.65 = stop - termina todas las batallas, cuentas atrás, cajas de temporizador, arenas, planos de cámara, música de batalla y observación
mobbattle.help.battles.66 = skipTimer - todos los temporizadores en marcha saltan a 0: las batallas terminan por su regla timeUp (draw, judge...)
mobbattle.help.battles.67 = army clearAll - disuelve el ejército de todos los jugadores
mobbattle.help.battles.68 = armyTint on|off - los mobs del ejército llevan un tinte mientras están en tu ejército (por defecto off)
mobbattle.help.battles.69 = armyTintColor <color> - el color del tinte del ejército, un color de la paleta (por defecto azul)
mobbattle.help.battles.71 = armyFriendlyFire on|off - los golpes dentro de un ejército (compañeros, un líder y sus mobs) hacen daño, pero siguen siendo aliados (por defecto off)
mobbattle.help.battles.72 = battleBelow <bloques>|off / battleAbove <bloques>|off - hasta cuántos bloques por debajo / por encima de su centro toma mobs un royale o todos contra uno (por defecto 50 / 40)
mobbattle.help.battles.73 = arenaVertical <bloques>|off - cuánto puede alejarse un luchador por encima o por debajo del nivel del ruedo antes de que el muro lo devuelva; a los voladores nunca (por defecto off)
mobbattle.help.battles.70 = resetAll - stop + teams clearAll + army clearAll + morph reset
mobbattle.help.teams.1 = Equipos
mobbattle.help.teams.2 = teams list - muestra los equipos
mobbattle.help.teams.3 = teams auto - mete en equipos a los mobs cercanos: primero las reglas de equipo de invocación, el resto un equipo por tipo (un solo tipo: se divide en dos)
mobbattle.help.teams.4 = teams start - empieza la batalla de equipos
mobbattle.help.teams.5 = teams clear - vacía tus equipos
mobbattle.help.teams.6 = teams clearAll - vacía los equipos de todos los jugadores
mobbattle.help.teams.7 = teams join <equipo> / leave - pelea tú mismo con un equipo (playerFights teams on)
mobbattle.help.teams.8 = teams add <nombre> <color> - equipo nuevo
mobbattle.help.teams.9 = teams color <equipo> <color> / rename <equipo> <nombre>
mobbattle.help.teams.10 = teams remove <equipo> / reset - vuelta a los 4 por defecto
mobbattle.help.teams.11 = teamLook both|tint|mist|off - aspecto de los mobs de equipo
mobbattle.help.teams.12 = teamLook time <segundos>|infinite - cuánto dura
mobbattle.help.teams.13 = teamLook onlyWand on|off - solo mientras llevas la Varita de Equipos
mobbattle.help.teams.14 = teamByType on|off - al pulsar un mob entran en el equipo todos los mobs de su tipo a menos de areaRadius
mobbattle.help.summon.1 = Lista de invocación
mobbattle.help.summon.2 = summon - invoca la lista a tu alrededor
mobbattle.help.summon.3 = summon list - muestra la lista
mobbattle.help.summon.4 = summon add <rol> [cantidad|random] [equipo] - cada add es una entrada aparte, aunque sea el mismo mob y equipo (Skeleton_Archer#2)
mobbattle.help.summon.5 = summon modify <entrada|rol> [equipo|none] <cantidad|random> - fija una cantidad exacta
mobbattle.help.summon.6 = summon remove <entrada> / clear
mobbattle.help.summon.7 = summon team <entrada> <equipo|none> - regla de equipo
mobbattle.help.summon.7b = summon team all none - todas las entradas pierden su equipo (los mobs se quedan)
mobbattle.help.summon.8 = summon random <mín> <máx> - rango para cantidades aleatorias
mobbattle.help.summon.9 = summonRadius <bloques>|auto - tamaño del área de invocación (auto crece con la cantidad)
mobbattle.help.summon.10 = summon atLeastOne true|false - los tipos aleatorios salen 1 o más
mobbattle.help.summon.11 = summonDespawn never|battleEnd|timer - las invocaciones se van solas: never (por defecto, se quedan), battleEnd (las invocaciones que sobreviven a una batalla se van al terminar), timer (cada una se va summonLifetime segundos después de aparecer)
mobbattle.help.summon.12 = summonLifetime <segundos> - cuánto vive una invocación con summonDespawn timer (5-3600, por defecto 60)
mobbattle.help.summon.13 = summonExit disintegrate|vanish|shatter - cómo se van las invocaciones: disintegrate como la Varita de Muerte (arranca el alma, sin botín, por defecto), vanish al instante (sin botín) o shatter como cristal de jade (sin botín)
mobbattle.help.summon.14 = summonCalm off|summons|all - las invocaciones esperan tranquilas hasta que una batalla, pelea de varita o ejército las toma: summons = se ignoran entre sí, all = también jugadores y otros mobs; un golpe deja que uno devuelva el golpe a su atacante (por defecto off)
mobbattle.help.summon.15 = summonArmy on|off - los mobs invocados se unen a tu ejército, como la Varita de Ejército (por defecto off)
mobbattle.help.summon.16 = summonJade on|off - las invocaciones salen con el aspecto de jade, como el de la Varita de Efectos (por defecto off)
mobbattle.help.summon.17 = summonJadeColor <color> - el color de jade de las invocaciones, un color de la paleta (por defecto verde)
mobbattle.help.summon.18 = summon fill <tipos> [each:<n>] [teams:<n>] [mod:..] [type:..] [group:..] [add] - mobs al azar que pelean, de fuerza parecida (vida máxima), a la lista; teams:2 los reparte en equipos equilibrados; reemplaza la lista salvo con add
mobbattle.help.summon.19 = summon lists / save <nombre> / load <nombre> / delete <nombre> - listas de invocación guardadas: los mobs, cantidades, equipos y sus colores, para cambiar entre tus listas
mobbattle.help.morph.1 = Transformación y efectos
mobbattle.help.morph.2 = morph <modelo> - fija el modelo de la Varita de Transformación
mobbattle.help.morph.3 = morph list [texto] - busca IDs de modelos
mobbattle.help.morph.4 = morph reset - todo mob transformado recupera su modelo
mobbattle.help.morph.5 = wandEffect <id> - efecto de la Varita de Efectos, p. ej. Burn; A>B>C da cada uno cuando termina el anterior; jade[:color], shimmer[:color]
mobbattle.help.morph.6 = waveTravel on|off - ondas de varitas (Transformación, Limpieza, Efectos, Curación): cada mob es golpeado cuando el anillo llega a él, no todos a la vez (por defecto on)
mobbattle.help.morph.7 = waveGroundOnly on|off - las ondas de varitas solo golpean mobs cerca del suelo, como los golpes del juego; los voladores y las cuevas se libran (por defecto off)
mobbattle.help.morph.8 = healArea on|off - Varita de Curación: mantén clic izquierdo para golpear el suelo y curar a todos los mobs y jugadores a tu alrededor, a ti también (por defecto on)
mobbattle.help.morph.9 = healRadius <bloques> - alcance de la curación con clic mantenido (por defecto 12)
mobbattle.help.morph.10 = healAreaSelf on|off - la curación con clic mantenido también te cura a ti (por defecto on)
mobbattle.help.morph.11 = effectAreaSelf on|off - la onda de efecto con clic mantenido también te da el efecto a ti (por defecto off)
mobbattle.help.morph.12 = effectArea on|off - Varita de Efectos: mantén clic izquierdo para dar el efecto a todos los mobs y jugadores a tu alrededor (por defecto on)
mobbattle.help.morph.13 = effectRadius <bloques> - alcance de la onda de efecto con clic mantenido (por defecto 12)
mobbattle.help.morph.14 = wandFx on|off - brillo, arrancar el alma, encanto, runas de invocación... sobre el mob pulsado
mobbattle.help.morph.15 = killDelay <segundos> - Varita de Muerte: tiempo arrancando el alma antes de morir (0-3, 0 = instantáneo)
mobbattle.help.morph.16 = killHitDelay <ms> - Varita de Muerte: espera tras el clic hasta que el hechizo impacta; el sonido Hakai y la desintegración empiezan entonces (por defecto 175, 0-2000)
mobbattle.help.morph.17 = killLoot on|off - los mobs matados por la Varita de Muerte o el Chasquido sueltan su botín (por defecto off)
mobbattle.help.morph.18 = lookGlow <0-15> - luz alrededor de mobs con aspecto jade/shimmer o el shimmer del buff, en su color (por defecto 6, 0 = off)
mobbattle.help.morph.19 = deathGlow <0-15> - Varita de Muerte: el mob que se desintegra destella en su color, apagándose (por defecto 12, 0 = off)
mobbattle.help.morph.20 = killPlayers on|off - la Varita de Muerte también funciona con jugadores: se desintegran y luego mueren con normalidad (por defecto on)
mobbattle.help.morph.28 = killArea on|off - Varita de Muerte: mantén clic izquierdo para golpear el suelo y matar a todos los mobs de alrededor; tu propio ejército se salva (por defecto on)
mobbattle.help.morph.29 = killRadius <bloques> - alcance de la muerte con clic mantenido (por defecto 12)
mobbattle.help.morph.30 = killAreaPlayers on|off - la muerte con clic mantenido también alcanza a jugadores (con killPlayers on; nunca a ti ni a quien no puede morir) (por defecto off)
mobbattle.help.morph.21 = morphPlayers on|off - la Varita de Transformación también funciona con jugadores (por defecto on)
mobbattle.help.morph.22 = morphBurst on|off - Varita de Transformación: mantén clic izquierdo para enviar una onda que da a todos los mobs de alrededor tu modelo copiado (por defecto on)
mobbattle.help.morph.23 = morphShuffle on|off - Varita de Transformación: mantén clic derecho para enviar una onda que intercambia los modelos de los mobs de alrededor en parejas al azar (por defecto on)
mobbattle.help.morph.24 = morphBurstRadius <bloques> - alcance de las ondas con clic mantenido (por defecto 12)
mobbattle.help.morph.25 = morphBurstSelf on|off - las ondas de transformación e intercambio con clic mantenido también te cambian a ti (por defecto off)
mobbattle.help.morph.26 = debugTrack <segundos> - Varita de Depuración: cuánto se sigue a un mob pulsado con clic izquierdo tras su informe (0-600, por defecto 30, 0 = solo informe)
mobbattle.help.morph.27 = eyeTest [<color>|off] - (experimental, admin) recolorea los ojos del mob más cercano (8 bloques) con una textura creada en tiempo de ejecución (color de la paleta, por defecto Purple); off devuelve los modelos originales
mobbattle.help.presets.1 = Presets
mobbattle.help.presets.2 = preset list - presets incluidos y guardados
mobbattle.help.presets.3 = preset default - todos los ajustes vuelven a su valor por defecto (las listas de equipos e invocaciones se quedan)
mobbattle.help.presets.4 = preset fight - solo las peleas: sin cuenta atrás, cámaras, títulos, música, láseres, runas, ondas, bordes, aspectos de mobs, corona, dibujos ni temporizadores
mobbattle.help.presets.5 = preset effects - cuenta atrás 3, temporizador de 2 min (gana quien tenga más salud; el royale mantiene 3 min judge), títulos, música, runas, área discBorder, ondas, bordes, aspectos de mobs, marcadores; sin cámaras ni láseres
mobbattle.help.presets.6 = preset debug - todo visible: área wall, ondas, bordes, aspectos de mobs, láseres, runas, arenas, aspecto de equipo both, tarjeta de duelo, marcadores (los presets nunca cambian el registro de depuración: es solo para admin)
mobbattle.help.presets.7 = preset cinematic - cuenta atrás 5, cámaras (duelo western, royale dron, allVsOne foco, equipos barrido), cámara final con número de muertes, bandas de película anchas, música, área, ondas, arenas, aspectos de mobs y corona; sin láseres, runas ni brillo de borde
mobbattle.help.presets.8 = preset save <nombre> / load <nombre> / delete <nombre> - tus propios presets
mobbattle.help.presets.9 = reset effects|cameras|titles|arenas|rules|wands|all - solo ese grupo de ajustes vuelve a su valor por defecto
mobbattle.help.server.1 = Configuración del servidor
mobbattle.help.server.2 = permissions open|server - open deja que cualquiera use y configure; server comprueba los permisos use/config
mobbattle.help.server.3 = dackoro.mob_battle.use - varitas y batallas iniciadas por jugadores (por defecto hytale:Adventurer)
mobbattle.help.server.4 = dackoro.mob_battle.config - ajustes, presets y configuración de equipos/invocaciones (por defecto hytale:Admin)
mobbattle.help.server.5 = dackoro.mob_battle.admin - stop, resetAll, skipTimer, army clearAll, teams clearAll, teams reset, morph reset, apply, registro de depuración, reload, give, permisos y eventos (por defecto hytale:Admin; obligatorio en ambos modos)
mobbattle.help.server.6 = config/panel abre el panel de ajustes para leer en cualquier modo; guardar necesita config cuando el modo server está activo.
mobbattle.help.server.7 = La pestaña Admin del panel es aparte y solo la ven los jugadores con el permiso admin real, incluso en modo open.
mobbattle.help.server.8 = permissions open|server, reload, stop, resetAll, skipTimer, army clearAll, teams clearAll, teams reset, morph reset, give, registro de depuración y eventos del servidor siguen siendo solo admin en ambos modos.
mobbattle.help.server.9 = Los ajustes puros funcionan desde la consola del servidor. Las acciones basadas en posición necesitan un jugador.
mobbattle.help.server.10 = Los ajustes del servidor están en el fx.properties del directorio de datos del plugin; edítalo con el servidor parado y luego ejecuta /mobbattle reload.
mobbattle.help.server.11 = reload - recarga fx.properties desde el disco (admin)
mobbattle.help.server.12 = measure [look|id:<uuid>|last] [segundos] | measure stop - velocidad (bloques/s) y altura de salto tuyos, del mob al que miras o de una entidad por id (funciona desde la consola), en el chat, 10 s por defecto, hasta 60 (admin; para calibrar buffs de tamaño y velocidad)
mobbattle.help.server.13 = test spawn <rol> <here|x y z> [cantidad] [mundo] [calm] | test list | test clear - mobs de prueba, con sus ids (admin; last = el más nuevo)
mobbattle.help.server.14 = test walk <id|last> <x> <z> - un mob de prueba camina hasta ese bloque (solo roles con comportamiento de ruta, sobre todo jefes)
mobbattle.help.server.15 = test chase <id|last> <here|x y z> - un muñeco de entrenamiento quieto allí, y el mob corre a atacarlo (cualquier mob que pueda atacar)
mobbattle.help.server.16 = test duel <rolA> <rolB> <distancia> <here|x y z> [mundo] - crea a ambos, empieza un duelo y registra cada golpe (daño, alcance) y un resumen
mobbattle.help.server.17 = test perf <rol> <cantidad> <here|x y z> [mundo] - el tiempo de tick del mundo durante 10 s antes y después de crearlos
mobbattle.help.server.18 = test royale <rol:cantidad+...> <here|x y z> <radio> [mundo] - crea la mezcla y empieza un battle royale, resumen al final
mobbattle.help.server.19 = test wave <heal|cleanse|effect|morph|shuffle> <here|x y z> [mundo] [efecto|modelo] - la onda de clic mantenido de una varita desde ese punto: a cuántos alcanzó y cuándo
mobbattle.help.server.20 = test stats <id|last> - salud, tamaño, buffs, efectos, batalla, calma, ejército y modelo en una línea
mobbattle.help.server.21 = test verify <here|x y z> [mod:<nombre>|mod:hytale] [type:<fighters|defend|noattack>] [texto] [time:<s>] [batch:<n>] - a cada rol se le ordena atacar a un muñeco quieto; dice qué suposiciones de Type eran erróneas (informe en tests/)
mobbattle.help.server.22 = test roles [mod:<nombre>|mod:hytale] [type:<fighters|defend|noattack|avoid>] [texto] - los roles de mob que dejan los filtros Show del panel, con mod y tipo
mobbattle.help.server.23 = test expect <id|last> <campo> <=|!=|>|<|>=|<=> <valor> - una comprobación (alive, health, maxhealth, healthpct, size, buff.<stat>, effect, battle, team, calm, army, morphed, model, x, y, z); los scripts las cuentan
mobbattle.help.server.24 = test camera <orbit|duel|showcase|teams|focus|drone|spotlight> <jugador> [segundos] - esa cámara de intro sobre los mobs de prueba, para ese jugador
mobbattle.help.server.25 = test snapshot [nombre] | test restore [nombre] - guarda fx.properties (ajustes, equipos, lista de invocación) y lo restaura
mobbattle.help.server.26 = test run <script> | test stop - ejecuta <directorio de datos>/tests/<script>.txt: un comando por línea, wait <segundos>, say <texto>, # comentarios
mobbattle.help.server.27 = apply <jugador|me|look|near <radio>|players|id:<uuid>|last> <acción> [valor] - una acción de varita sobre jugadores o mobs elegidos (admin): buff <clics>, size|health|damage|defense <valor>, unbuff, heal, cleanse, effect <id>, look jade|shimmer[:color], morph <modelo|jugador>, unmorph, army add|remove, team <equipo|none>
mobbattle.help.server.28 = El modo de permisos se guarda en fx.properties y los presets/reset lo conservan; cámbialo explícitamente con el comando permissions, solo para admin.
mobbattle.help.server.29 = event duel <uuidA> <uuidB> [mundo] - empieza un duelo de NPC sin dueño
mobbattle.help.server.30 = event royale <x> <y> <z> <radio> [maxMobs] [mundo] - empieza un royale de NPC sin dueño
mobbattle.help.server.31 = event focus <uuid> [mundo] - los NPC cercanos atacan al NPC indicado
mobbattle.help.server.32 = event list [radio] - muestra los UUID de NPC cercanos (admin; solo jugador)
mobbattle.help.server.33 = pictures status | rebuild [force] - las fotos del VS, miniaturas, hologramas e iconos: qué hay en caché y qué se envía, o volver a dibujarlas en segundo plano con el progreso en el chat (admin; force = todas, no solo las que faltan o están desactualizadas)
mobbattle.help.server.34 = serverVs|serverHolograms|serverIcons on|off - (admin) funciones del servidor: apaga la pantalla VS, el holograma de la Varita de Morph o las imágenes de mobs del panel en este servidor; apagadas, sus imágenes dejan de enviarse a los jugadores que entran desde el próximo reinicio (por defecto on)
mobbattle.help.server.35 = p. ej. serverVs off: sin pantallas VS y unos 35-50 MB menos para cada jugador que entra
mobbattle.help.config.1 = Panel de configuración
mobbattle.help.config.2 = /mobbattle config o /mobbattle panel - abre el panel de ajustes; ambos comandos son públicos para leer.
mobbattle.help.config.3 = Menú izquierdo: Presentación, Cámaras, Batallas, una pestaña por tipo de batalla (Duelo, Todos contra uno, Royale, Batallas de equipos),
mobbattle.help.config.4 = Área del Caos, Colores y aspectos, Buffs, Varitas, Equipos, Lista de invocación, Presets y reinicio, Herramientas, Admin. Todos los ajustes que cambian los comandos están ahí.
mobbattle.help.config.5 = Cambiar un valor solo lo marca (dorado): Guardar cambios los aplica todos a la vez, Descartar cambios los descarta.
mobbattle.help.config.6 = Los botones de Presets y Reinicio rellenan primero el formulario, así puedes revisarlos antes de guardar.
mobbattle.help.config.7 = Los botones de lista de equipos, lista de invocación, herramientas y admin ejecutan su comando al instante (el chat muestra el resultado).
mobbattle.help.config.8 = En modo server, guardar necesita dackoro.mob_battle.config; la página Admin necesita dackoro.mob_battle.admin.
mobbattle.help.config.9 = Admin es una pestaña aparte, visible solo con un permiso dackoro.mob_battle.admin real en cualquier modo de permisos.
mobbattle.help.config.10 = Página Admin: permissions open|server, reload, give, terminar temporizadores, evento royale, stop, ejércitos, equipos, transformaciones, resetAll.
